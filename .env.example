DEWEY_CONFIG_DIR=/config

DEWEY_MAM_URL=https://www.myanonamouse.net
DEWEY_MAM_ID=
DEWEY_MAM_AUDIOBOOK_CATEGORY=13
DEWEY_MAM_SEARCH_LIMIT=100
DEWEY_MAM_MIN_RELEVANCE=45
DEWEY_MAM_MIN_SEEDERS=0
DEWEY_MAM_DEFAULT_FORMAT=
DEWEY_MAM_DEFAULT_LANGUAGE=
DEWEY_MAM_DEFAULT_SEARCH_TYPE=all
# DEWEY_SEARCH_PROFILES='[{"id":"m4b-english","name":"M4B English","format":"m4b","language":"ENG","min_seeders":1,"min_relevance":55,"search_type":"active","category":"13"}]'
DEWEY_MAM_SORT_TYPE=default
DEWEY_MAM_UPDATE_SEEDBOX_IP=false
DEWEY_MAM_VIP_STATUS=unknown
DEWEY_MAM_BLOCK_VIP_WHEN_INACTIVE=true
DEWEY_MAM_VIP_STORE_URL=https://www.myanonamouse.net/store.php
# DEWEY_MAM_ACCOUNT_CLASS=
# DEWEY_MAM_VIP_UNTIL=
# DEWEY_MAM_ACCOUNT_LAST_REFRESH=
DEWEY_MAM_ACCOUNT_AUTO_REFRESH_ENABLED=true
DEWEY_MAM_ACCOUNT_REFRESH_INTERVAL_HOURS=8
# DEWEY_MAM_BONUS_POINTS=0
# DEWEY_MAM_FREELEECH_WEDGES=0

DEWEY_QBITTORRENT_URL=http://qbittorrent:8080
DEWEY_QBITTORRENT_USERNAME=
DEWEY_QBITTORRENT_PASSWORD=
DEWEY_QBITTORRENT_CATEGORY=dewey
DEWEY_QBITTORRENT_SAVE_PATH=/data/torrents/dewey
DEWEY_ENSURE_QBITTORRENT_CATEGORY=true
DEWEY_MONITOR_INTERVAL_SECONDS=30

DEWEY_AUDIOBOOKS_DIR=/data/audiobooks
DEWEY_TORRENTS_DIR=/data/torrents
DEWEY_UNSORTED_FOLDER=_unsorted
DEWEY_AUTHOR_MATCH_THRESHOLD=85
DEWEY_METADATA_CONFIDENCE_THRESHOLD=74
DEWEY_FALLBACK_CONFIDENCE_THRESHOLD=65
DEWEY_INCLUDE_SERIES_IN_BOOK_FOLDER=false

DEWEY_AUDIOBOOKSHELF_SCAN_ENABLED=false
DEWEY_AUDIOBOOKSHELF_URL=http://audiobookshelf:80
DEWEY_AUDIOBOOKSHELF_API_KEY=
DEWEY_AUDIOBOOKSHELF_LIBRARY_ID=
DEWEY_AUDIOBOOKSHELF_FORCE_SCAN=false

DEWEY_OPENLIBRARY_URL=https://openlibrary.org
DEWEY_OPENLIBRARY_USER_AGENT=Dewey/0.1 (+self-hosted audiobook importer)
DEWEY_METADATA_PROVIDER=openlibrary

DEWEY_AUTH_ENABLED=false
DEWEY_AUTH_USERNAME=admin
# Configure the login password from Dewey's Settings page so only a hash is stored.
# DEWEY_AUTH_PASSWORD_HASH=
# DEWEY_AUTH_SESSION_SECRET=
DEWEY_AUTH_COOKIE_NAME=dewey_session
DEWEY_AUTH_COOKIE_SECURE=false
DEWEY_AUTH_SESSION_TTL_HOURS=168

DEWEY_LOG_LEVEL=INFO
